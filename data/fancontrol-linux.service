[Unit]
Description=LiFaCo (fan control)
After=systemd-modules-load.service lm-sensors.service
Conflicts=fancontrol.service

[Service]
Type=simple
ExecStart=/usr/local/bin/fancontrol-linuxd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
# liquidctl keeps device state in /run/liquidctl; the strict sandbox needs it listed as a runtime directory.
# Preserve it on stop so other liquidctl users keep their state.
RuntimeDirectory=fancontrol-linux liquidctl
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
# Lighting plugins: their files and data live in /var/lib/fancontrol-linux; the udev rules grant them device access.
ReadWritePaths=/etc/fancontrol-linux /var/lib/fancontrol-linux -/etc/udev/rules.d
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
