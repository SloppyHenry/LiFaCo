[Unit]
Description=FanControl for Linux (Lüftersteuerung)
After=systemd-modules-load.service lm-sensors.service
Conflicts=fancontrol.service

[Service]
Type=simple
ExecStart=/usr/local/bin/fancontrol-linuxd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
RuntimeDirectory=fancontrol-linux
RuntimeDirectoryMode=0755
ProtectSystem=strict
ReadWritePaths=/etc/fancontrol-linux
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
